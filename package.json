{
  "name": "@ansanloms/redocly-plugin-inline-examples",
  "version": "0.1.0",
  "description": "Redocly preprocessor plugin that inlines $ref'd YAML files under examples",
  "keywords": [
    "openapi",
    "preprocessor",
    "redocly"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansanloms/redocly-plugin-inline-examples.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "compile": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test '*.test.ts'",
    "lint": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@redocly/openapi-core": "2.62.1",
    "@types/node": "24.19.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@redocly/openapi-core": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@redocly/openapi-core": {
      "optional": true
    }
  }
}
